{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hussh:pkm:website-credential-item:v1",
  "$comment": "Canonical encrypted secrets.items[sec_<16-hex>] website-login format shared by One and Search Console. This schema never authorizes model disclosure, standing pod custody or website transmission. Legacy website records normalize on the unlocked client; unrelated Secrets records and unknown encrypted fields are preserved.",
  "title": "WebsiteCredentialItemV1",
  "type": "object",
  "required": ["schema_version", "label", "kind", "pattern_id", "file_to", "offer_noun", "value", "created_at", "updated_at", "credential", "bound_origins", "stay_signed_in_enabled", "revision"],
  "properties": {
    "schema_version": {"const": 1},
    "label": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"const": "credential"},
    "pattern_id": {"const": "website_credential"},
    "file_to": {"const": "none"},
    "offer_noun": {"type": "null"},
    "value": {"type": "string", "minLength": 1, "maxLength": 8192, "description": "The password, only inside the owner-encrypted Secrets item. No duplicate password field."},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "credential": {
      "type": "object",
      "required": ["title", "origin", "domain", "url", "username"],
      "properties": {
        "title": {"type": "string"},
        "origin": {"type": "string", "pattern": "^https://[^/?#@]+$"},
        "domain": {"type": "string"},
        "url": {"type": "string"},
        "username": {"type": "string", "maxLength": 1024},
        "notes": {"type": "string", "maxLength": 4096}
      },
      "additionalProperties": true
    },
    "bound_origins": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^/?#@]+$"}},
    "totp_secret": {"type": "string", "pattern": "^[A-Z2-7]{16,128}$"},
    "stay_signed_in_enabled": {"type": "boolean", "default": false},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "legacy_credential_id": {"type": "string"}
  },
  "additionalProperties": true
}
