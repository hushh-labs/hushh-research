{
  "$comment": "Which spans of text are secrets: API keys, passwords, tokens, private keys, card numbers and government ID numbers. One truth table read by the device guard (hushh-webapp/lib/pkm/secret-patterns.ts), which saves each span to the reserved Secrets area and replaces it with a placeholder BEFORE any model, chat history, memory proposal or telemetry sees the text, and by the server's second net (consent-protocol/hushh_mcp/consent/secret_patterns.py), which reports spans and kinds and never a value. Byte-identical copies live in consent-protocol/contracts/pkm/ and hushh-webapp/contracts/pkm/; parity tests fail on drift. Changed only by a reviewed release.",
  "version": 1,

  "$comment_syntax": "Patterns use the shared subset of Python and JavaScript regex syntax: no lookbehind, no named groups, no inline flags. Both sides compile with ASCII semantics (Python re.ASCII) and add case folding only where ignore_case is true. value_group is the capture group that holds the secret value (0 = the whole match); the label is built on the device from the pattern label, the words just before the match, and the masked value.",
  "$comment_kind": "kind is the coarse category the server already reports (credential, card_number, card_security_code, government_id, bank_account). file_to is where the owner may file the value from Secrets with an explicit tap: wallet (the Wallet add form), kyc_identity_documents (KYC identity documents), or none. Filing never happens without the owner.",
  "$comment_false_positives": "Not secrets, and never matched: environment variable NAMES (STRIPE_SECRET_KEY, GITHUB_TOKEN), references to a secret store (${VAR}, projects/x/secrets/y), file paths, placeholders (xxxx, <your-key>, changeme), URLs without credentials, GCP project IDs, OAuth URLs and app IDs. The validators below enforce this for assignment-shaped patterns, and the cases section proves it on both sides.",

  "placeholder": {
    "$comment": "What replaces a secret span in the text. The id names the item in the secrets domain; the label is masked and safe to show to the model. A span already inside a placeholder is never matched again.",
    "open": "⟦secret:",
    "close": "⟧",
    "id_pattern": "^sec_[a-f0-9]{16}$",
    "token_pattern": "⟦secret:(sec_[a-f0-9]{16}) ([^⟦⟧\\n]{1,80})⟧",
    "label_max_chars": 80
  },

  "validators": {
    "$comment": "Named checks applied to the value_group text after a regex match. Implemented identically in both loaders.",
    "luhn_run": "13 to 19 digits once spaces and dashes are removed, passing the Luhn checksum. Judged on the whole run, never a window inside it.",
    "verhoeff": "12 digits once spaces are removed, first digit 2 to 9, passing the Verhoeff checksum (Aadhaar).",
    "iban_mod97": "An IBAN whose rearranged digits are 1 modulo 97.",
    "password_value": "Not a reference or placeholder (see reference_value), at least 4 characters.",
    "token_value": "Not a reference or placeholder, at least 8 characters, and random-looking: a digit, or both lower and upper case letters.",
    "phrase_value": "Not a reference or placeholder, at least 4 characters, and holding a digit or a symbol, so 'the password is long' is prose and 'the password is hunter2!' is a password.",
    "reference_value": "Shared by the three above. Rejects an environment variable name (UPPER_SNAKE with at least one underscore), anything starting with $ % < or {, anything containing ://, a secret-store path (starts with projects/ or contains /secrets/), a file path (starts with / ./ ../ or ~/), a value made of one repeated mask character, a value starting with your_ your- my_ my-, and the placeholder words below."
  },
  "placeholder_words": [
    "changeme", "change_me", "empty", "example", "hidden", "none", "null", "optional", "password",
    "placeholder", "redacted", "required", "secret", "tbd", "todo", "token", "undefined", "unset"
  ],

  "patterns": [
    {
      "id": "pem_private_key", "kind": "credential", "label": "Private key", "file_to": "none",
      "mask": "none", "label_context": true, "label_from_prefix": false,
      "pattern": "-----BEGIN ((?:[A-Z0-9]+ )*PRIVATE KEY)-----[\\s\\S]*?-----END \\1-----",
      "ignore_case": false, "value_group": 0, "validator": null
    },
    {
      "id": "aws_access_key_id", "kind": "credential", "label": "AWS access key", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b((?:AKIA|ASIA)[A-Z0-9]{16})\\b",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "aws_secret_access_key", "kind": "credential", "label": "AWS secret key", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\baws_secret_access_key\\b\\s*[:=]\\s*[\"']?([A-Za-z0-9/+=]{40})(?![A-Za-z0-9/+=])",
      "ignore_case": true, "value_group": 1, "validator": null
    },
    {
      "id": "github_token", "kind": "credential", "label": "GitHub token", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b(gh[pousr]_[A-Za-z0-9]{36,255})\\b",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "github_fine_grained_token", "kind": "credential", "label": "GitHub token", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b(github_pat_[A-Za-z0-9_]{22,255})\\b",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "stripe_secret_key", "kind": "credential", "label": "Stripe key", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b((?:sk|rk)_(?:live|test|prod)_[A-Za-z0-9]{8,})\\b",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "stripe_webhook_secret", "kind": "credential", "label": "Stripe webhook secret", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b(whsec_[A-Za-z0-9]{24,})\\b",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "slack_token", "kind": "credential", "label": "Slack token", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b(xox[abposr]-[A-Za-z0-9-]{10,})",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "model_provider_key", "kind": "credential", "label": "API key", "file_to": "none",
      "mask": "last4", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b(sk-(?:proj-|ant-)?[A-Za-z0-9_-]{20,})",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "google_api_key", "kind": "credential", "label": "Google API key", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b(AIza[0-9A-Za-z_-]{35})",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "google_oauth_client_secret", "kind": "credential", "label": "OAuth client secret", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b(GOCSPX-[A-Za-z0-9_-]{20,})",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "jwt", "kind": "credential", "label": "Signed token", "file_to": "none",
      "mask": "last4", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b(eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "bearer_token", "kind": "credential", "label": "Bearer token", "file_to": "none",
      "mask": "last4", "label_context": true, "label_from_prefix": false,
      "pattern": "\\bbearer\\s+([A-Za-z0-9._~+/-]{20,}=*)",
      "ignore_case": true, "value_group": 1, "validator": "token_value"
    },
    {
      "id": "url_password", "kind": "credential", "label": "Password in a link", "file_to": "none",
      "mask": "none", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b[a-z][a-z0-9+.-]*://[^\\s:/@]+:([^\\s:/@]+)@",
      "ignore_case": true, "value_group": 1, "validator": null
    },
    {
      "id": "env_secret_assignment", "kind": "credential", "label": "Secret", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": true,
      "pattern": "\\b[A-Z][A-Z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN|API_KEY|APIKEY|PRIVATE_KEY|ACCESS_KEY)[A-Z0-9_]*\\s*=\\s*[\"']?([^\\s\"',;]{3,}[^\\s\"',;.!?):])",
      "ignore_case": false, "value_group": 1, "validator": "password_value"
    },
    {
      "id": "password_assignment", "kind": "credential", "label": "Password", "file_to": "none",
      "mask": "none", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b(?:password|passwd|pwd|passphrase|passcode)\\b\\s*[:=]\\s*[\"']?([^\\s\"',;]{3,}[^\\s\"',;.!?):])",
      "ignore_case": true, "value_group": 1, "validator": "password_value"
    },
    {
      "id": "password_phrase", "kind": "credential", "label": "Password", "file_to": "none",
      "mask": "none", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b(?:password|passphrase|passcode)\\s+(?:is|was)\\s+[\"']?([^\\s\"',;]{3,}[^\\s\"',;.!?):])",
      "ignore_case": true, "value_group": 1, "validator": "phrase_value"
    },
    {
      "id": "api_key_assignment", "kind": "credential", "label": "API key", "file_to": "none",
      "mask": "last4", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b(?:api[ _-]?key|apikey|access[ _-]?key)\\b\\s*(?:[:=]|is)\\s*[\"']?([^\\s\"',;]{7,}[^\\s\"',;.!?):])",
      "ignore_case": true, "value_group": 1, "validator": "token_value"
    },
    {
      "id": "token_assignment", "kind": "credential", "label": "Token", "file_to": "none",
      "mask": "last4", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b(?:(?:access|auth|refresh|bearer|session)[ _-]?)?token\\b\\s*(?:[:=]|is)\\s*[\"']?([^\\s\"',;]{7,}[^\\s\"',;.!?):])",
      "ignore_case": true, "value_group": 1, "validator": "token_value"
    },
    {
      "id": "secret_assignment", "kind": "credential", "label": "Secret", "file_to": "none",
      "mask": "last4", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b(?:secret[ _-]?key|client[ _-]?secret|private[ _-]?key|secret)\\b\\s*(?:[:=]|is)\\s*[\"']?([^\\s\"',;]{7,}[^\\s\"',;.!?):])",
      "ignore_case": true, "value_group": 1, "validator": "token_value"
    },
    {
      "id": "card_number", "kind": "card_number", "label": "Card", "file_to": "wallet", "offer_noun": "this card",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b\\d(?:[ -]?\\d)*\\b",
      "ignore_case": false, "value_group": 0, "validator": "luhn_run"
    },
    {
      "id": "card_security_code", "kind": "card_security_code", "label": "Card security code", "file_to": "none",
      "mask": "none", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b(?:cvv2|cvv|cvc)\\b\\s*(?:is|:|=|-)?\\s*(\\d{3,4})\\b",
      "ignore_case": true, "value_group": 1, "validator": null
    },
    {
      "id": "card_pin", "kind": "card_security_code", "label": "PIN", "file_to": "none",
      "mask": "none", "label_context": true, "label_from_prefix": false,
      "pattern": "\\bpin\\b\\s*(?:code\\s*)?(?:is|:|=|-)?\\s*(\\d{4,6})\\b",
      "ignore_case": true, "value_group": 1, "validator": null
    },
    {
      "id": "ssn", "kind": "government_id", "label": "SSN", "file_to": "kyc_identity_documents", "offer_noun": "SSN",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b(\\d{3}-\\d{2}-\\d{4})\\b",
      "ignore_case": false, "value_group": 1, "validator": null
    },
    {
      "id": "aadhaar", "kind": "government_id", "label": "Aadhaar number", "file_to": "kyc_identity_documents", "offer_noun": "Aadhaar",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b(\\d{4} \\d{4} \\d{4})\\b(?![ -]?\\d)",
      "ignore_case": false, "value_group": 1, "validator": "verhoeff"
    },
    {
      "id": "passport_number", "kind": "government_id", "label": "Passport", "file_to": "kyc_identity_documents", "offer_noun": "passport",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\bpassport\\b[^\\n]{0,24}?\\b([A-Z]{1,2}\\d{6,8}|\\d{9})\\b",
      "ignore_case": true, "value_group": 1, "validator": null
    },
    {
      "id": "bank_account_number", "kind": "bank_account", "label": "Bank account number", "file_to": "none",
      "mask": "last4", "label_context": true, "label_from_prefix": false,
      "pattern": "\\b(?:bank\\s+)?(?:account|acct)\\s*(?:number|num|no\\.?|#)\\s*(?:is|:|=|-)?\\s*([A-Z]{0,2}\\d{8,17})\\b",
      "ignore_case": true, "value_group": 1, "validator": null
    },
    {
      "id": "iban", "kind": "bank_account", "label": "IBAN", "file_to": "none",
      "mask": "last4", "label_context": false, "label_from_prefix": false,
      "pattern": "\\b([A-Z]{2}\\d{2}[A-Z0-9]{11,30})\\b",
      "ignore_case": false, "value_group": 1, "validator": "iban_mod97"
    }
  ],

  "$comment_cases": "Shared fixtures run by BOTH loaders, so a regex that compiles differently in Python and JavaScript fails here. Every value is synthetic. A case's text is its parts joined with no separator, and each expected value likewise: no fixture writes a token-shaped string in one piece, so the repository's own secret scanner never sees a credential-shaped literal.",
  "cases": [
    {"parts": ["my github token is gh", "p_", "fakefake0000fakefake0000fakefake0000"], "expect": [{"id": "github_token", "value": ["gh", "p_", "fakefake0000fakefake0000fakefake0000"]}], "why": "A GitHub token by its prefix."},
    {"parts": ["deploy key AK", "IAFAKE0000FAKE0000"], "expect": [{"id": "aws_access_key_id", "value": ["AK", "IAFAKE0000FAKE0000"]}], "why": "An AWS access key id."},
    {"parts": ["stripe: sk", "_test_", "fakefake0000fakefake"], "expect": [{"id": "stripe_secret_key", "value": ["sk", "_test_", "fakefake0000fakefake"]}], "why": "A Stripe secret key."},
    {"parts": ["openai key s", "k-proj-", "fakefake0000fakefake0000"], "expect": [{"id": "model_provider_key", "value": ["s", "k-proj-", "fakefake0000fakefake0000"]}], "why": "A model provider API key."},
    {"parts": ["api_key: fake0000fake"], "expect": [{"id": "api_key_assignment", "value": ["fake0000fake"]}], "why": "A generic api key assignment."},
    {"parts": ["Netflix password: hunter2fake"], "expect": [{"id": "password_assignment", "value": ["hunter2fake"]}], "why": "A password assignment."},
    {"parts": ["my bank password is Fake-pass-42!"], "expect": [{"id": "password_phrase", "value": ["Fake-pass-42"]}], "why": "A password stated in prose; the closing punctuation is not part of it."},
    {"parts": ["DATABASE_PASS", "WORD=fakefake42"], "expect": [{"id": "env_secret_assignment", "value": ["fakefake42"]}], "why": "An environment line with a real value."},
    {"parts": ["-----BEGIN PRIV", "ATE KEY-----\\nFAKEFAKEFAKE\\n-----END PRIV", "ATE KEY-----"], "expect": [{"id": "pem_private_key", "value": ["-----BEGIN PRIV", "ATE KEY-----\\nFAKEFAKEFAKE\\n-----END PRIV", "ATE KEY-----"]}], "why": "A PEM private key, including the escaped newlines of a GCP service-account JSON file."},
    {"parts": ["session ey", "JfakefakeFAKE.ey", "JfakefakeFAKE.fakefakeFAKE"], "expect": [{"id": "jwt", "value": ["ey", "JfakefakeFAKE.ey", "JfakefakeFAKE.fakefakeFAKE"]}], "why": "A signed JSON web token."},
    {"parts": ["postgres://admin:", "fakepass42", "@db.example.test/app"], "expect": [{"id": "url_password", "value": ["fakepass42"]}], "why": "A password inside a link."},
    {"parts": ["card 4111 1111 1111 1111 exp 04/30"], "expect": [{"id": "card_number", "value": ["4111 1111 1111 1111"]}], "why": "A Luhn-valid card number with spaces."},
    {"parts": ["amex 378282246310005"], "expect": [{"id": "card_number", "value": ["378282246310005"]}], "why": "A 15-digit card number."},
    {"parts": ["use 4111-1111-1111-1111 please"], "expect": [{"id": "card_number", "value": ["4111-1111-1111-1111"]}], "why": "A card number written with dashes, judged as one whole run."},
    {"parts": ["cvv 123"], "expect": [{"id": "card_security_code", "value": ["123"]}], "why": "A card security code."},
    {"parts": ["SSN 123-45-6789"], "expect": [{"id": "ssn", "value": ["123-45-6789"]}], "why": "A US Social Security number."},
    {"parts": ["passport number X1234567"], "expect": [{"id": "passport_number", "value": ["X1234567"]}], "why": "A passport number with its word."},
    {"parts": ["account number: 12345678901"], "expect": [{"id": "bank_account_number", "value": ["12345678901"]}], "why": "A bank account number with its words."},
    {"parts": ["IBAN GB82WEST12345698765432"], "expect": [{"id": "iban", "value": ["GB82WEST12345698765432"]}], "why": "The published example IBAN, which passes mod 97."},

    {"parts": ["Set STRIPE_SECRET_KEY and GITHUB_TOKEN in Secret Manager"], "expect": [], "why": "Environment variable NAMES are work context, not secrets."},
    {"parts": ["api_key: ${OPENAI_API_KEY}"], "expect": [], "why": "A reference to a secret is not the secret."},
    {"parts": ["API_KEY=GEMINI_API_KEY"], "expect": [], "why": "An assignment whose value is another variable name."},
    {"parts": ["token: projects/hushh-pda-dev/secrets/stripe-key/versions/latest"], "expect": [], "why": "A secret-store path."},
    {"parts": ["password: changeme"], "expect": [], "why": "A placeholder word."},
    {"parts": ["the token is expired, max token: 4096"], "expect": [], "why": "Prose and a number setting are not tokens."},
    {"parts": ["the password is long"], "expect": [], "why": "A password described, not stated."},
    {"parts": ["See https://accounts.google.com/o/oauth2/auth?client_id=1234567890-fake.apps.googleusercontent.com&redirect_uri=https://app.example.test/cb"], "expect": [], "why": "An OAuth URL without credentials, and an OAuth client id, are not secrets."},
    {"parts": ["GCP project hushh-pda-dev, app id 1:123456789012:ios:fakefake0000"], "expect": [], "why": "Project and app ids are work context."},
    {"parts": ["AWS account 123456789012"], "expect": [], "why": "A cloud account id without an account-number phrase."},
    {"parts": ["order 1234567890123456 shipped"], "expect": [], "why": "A long order number that fails Luhn."},
    {"parts": ["call me at +1 415 555 0100"], "expect": [], "why": "A phone number."},
    {"parts": ["meet on 2026-10-01 at 10:30"], "expect": [], "why": "A date and time."},
    {"parts": ["already saved ⟦secret:sec_00000000000000ab GitHub token ending 0000⟧ thanks"], "expect": [], "why": "A placeholder is never matched again."}
  ]
}
