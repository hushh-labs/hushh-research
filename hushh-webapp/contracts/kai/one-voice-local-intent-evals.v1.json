{
  "schema_version": "one.voice_local_intent_evals.v1",
  "privacy": "redacted-only",
  "cases": [
    {
      "id": "location-create-circle-named",
      "utterance": "make a circle called Family",
      "context": {"contextRevision": "ctx-1", "catalogVersion": "gateway-1", "availableActionIds": ["location.create_circle"]},
      "expected": {"disposition": "action", "actionId": "location.create_circle", "slots": {"name": "Family"}}
    },
    {
      "id": "location-create-circle-missing-name",
      "utterance": "create a circle",
      "context": {"contextRevision": "ctx-1", "catalogVersion": "gateway-1", "availableActionIds": ["location.create_circle"]},
      "expected": {"disposition": "clarify", "actionId": "location.create_circle", "missingSlots": ["name"]}
    },
    {
      "id": "location-enable",
      "utterance": "turn location sharing on",
      "context": {"contextRevision": "ctx-2", "catalogVersion": "gateway-1", "availableActionIds": ["location.resume_updates"]},
      "expected": {"disposition": "action", "actionId": "location.resume_updates"}
    },
    {
      "id": "location-count",
      "utterance": "how many circles do I have",
      "context": {"contextRevision": "ctx-3", "catalogVersion": "gateway-1", "availableActionIds": [], "redactedState": {"circleCount": 4}},
      "expected": {"disposition": "read_answer", "readCapability": "list_my_location_circles", "slots": {"count": 4}}
    },
    {
      "id": "location-ambiguous",
      "utterance": "handle my location",
      "context": {"contextRevision": "ctx-4", "catalogVersion": "gateway-1", "availableActionIds": ["location.resume_updates", "location.pause_updates"]},
      "expected": {"disposition": "clarify", "reason": "ambiguous"}
    },
    {
      "id": "location-sos-blocked",
      "utterance": "send an SOS",
      "context": {"contextRevision": "ctx-5", "catalogVersion": "gateway-1", "availableActionIds": ["location.trigger_sos"]},
      "expected": {"disposition": "unsupported", "reason": "sos_send_blocked"}
    },
    {
      "id": "location-off-screen-rejected",
      "utterance": "create a circle called Family",
      "context": {"contextRevision": "ctx-6", "catalogVersion": "gateway-1", "availableActionIds": ["location.open_now"]},
      "expected": {"disposition": "unsupported", "reason": "action_unavailable"}
    },
    {
      "id": "location-disable",
      "utterance": "pause my location updates",
      "context": {"contextRevision": "ctx-7", "catalogVersion": "gateway-1", "availableActionIds": ["location.pause_updates"]},
      "expected": {"disposition": "action", "actionId": "location.pause_updates"}
    },
    {
      "id": "location-create-circle-paraphrase",
      "utterance": "start a new group named Weekend",
      "context": {"contextRevision": "ctx-8", "catalogVersion": "gateway-1", "availableActionIds": ["location.create_circle"]},
      "expected": {"disposition": "action", "actionId": "location.create_circle", "slots": {"name": "Weekend"}}
    },
    {
      "id": "location-disable-paraphrase",
      "utterance": "turn sharing off",
      "context": {"contextRevision": "ctx-9", "catalogVersion": "gateway-1", "availableActionIds": ["location.pause_updates"]},
      "expected": {"disposition": "action", "actionId": "location.pause_updates"}
    },
    {
      "id": "location-share-duration",
      "utterance": "share with them for 2 hours",
      "context": {"contextRevision": "ctx-10", "catalogVersion": "gateway-1", "availableActionIds": ["location.share_selected"]},
      "expected": {"disposition": "action", "actionId": "location.share_selected", "slots": {"person": "them", "duration_hours": 2}}
    },
    {
      "id": "location-share-missing-duration",
      "utterance": "share with them",
      "context": {"contextRevision": "ctx-11", "catalogVersion": "gateway-1", "availableActionIds": ["location.share_selected"]},
      "expected": {"disposition": "clarify", "actionId": "location.share_selected", "slots": {"person": "them"}, "missingSlots": ["duration_hours"]}
    },
    {
      "id": "location-add-slot-order",
      "utterance": "add Sarah to Family",
      "context": {"contextRevision": "ctx-12", "catalogVersion": "gateway-1", "availableActionIds": ["location.add_to_circle"]},
