  "actions": [
    {
      "action_id": "email.chat.turn",
      "label": "Ask Email",
      "meaning": "Delegates a governed read-only Gmail or Email triage turn to the Email specialist under One.",
      "aliases": [
        "what needs a reply today",
        "what needs a reply",
        "what needs reply today",
        "check my inbox",
        "show emails that need a reply",
        "summarize my gmail",
        "search my email"
      ],
      "search_keywords": [
        "email",
        "gmail",
        "inbox",
        "needs a reply",
        "unread email",
        "reply today"
      ],
      "delegate_agent_id": "agent_email",
      "reachability": {
        "routes": [
          "/one/gmail",
          "/one"
        ],
        "screens": [
          "gmail",
          "one_agents"
        ],
        "hidden_navigable": true,
        "navigation_prerequisites": [
          "gmail connection required for mailbox content"
        ]
      },
      "guard_ids": [
        "auth_signed_in",
        "vault_owner_token"
      ],
      "risk_level": "low",
      "execution_policy": "allow_direct",
      "execution_target": {
        "status": "wired",
        "path": "voice_tool",
        "target": "specialist_chat.turn",
        "params": {
          "delegate_agent_id": "agent_email"
        }
      },
      "control_ids": [
        "agent_chat_email_turn"
      ],
      "state_exposure": [
        "gmail_connection_status",
        "vault_ready",
        "allowed_action_ids"
      ],
      "docs_references": [
        "docs/reference/one/one-agent-hierarchy.md"
      ],
      "goal": {
        "goal_id": "goal.email.chat.turn",
        "required_inputs": [
          {
            "name": "utterance",
            "slot": "utterance",
            "prompt": "What should I ask Email?",
            "required": true,
            "resolver": "user_utterance"
          }
        ],
        "input_resolvers": [
          "user_utterance",
          "gmail_connection_status"
        ],
        "slot_schema": {
          "utterance": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "workflow_steps": [
          {
            "type": "tool_call",
            "label": "Delegate to Email specialist",
            "service": "specialist_chat.turn",
            "failure_behavior": "stop",
            "settlement_target": {
              "route": "/one/gmail",
              "screen": "gmail"
            }
          }
        ],
        "progress_contract": {
          "mode": "single_turn",
          "milestone_events": [
            "delegated",
            "completed"
          ]
        },
        "cancellation_contract": {
          "cancellable": false,
          "cancel_action_id": null
        },
        "result_contract": {
          "summary_mode": "specialist_answer"
        },
        "entrypoint_support": [
          "voice",
          "chat",
          "typed_search",
          "command_bar",
          "ui"
        ]
      }
    },
