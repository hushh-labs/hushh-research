      "action_id": "email.chat.turn",
      "label": "Ask Email",
      "meaning": "Delegates a governed approval-draft or client-request turn to the Email specialist under One.",
      "aliases": [
        "what needs a reply today",
        "what needs a reply",
        "what needs reply today",
        "check my inbox",
        "show emails that need a reply",
        "search my email"
      ],
      "search_keywords": [
        "email",
        "inbox",
        "needs a reply",
        "unread email",
        "reply today"
      ],
      "delegate_agent_id": "agent_email",
      "reachability": {
        "routes": [
          "/one"
        ],
        "screens": [
          "one_agents"
        ],
        "hidden_navigable": true,
        "navigation_prerequisites": [
          "exact information authority is required for email workflows"
        ]
      },
      "guard_ids": [
        "auth_signed_in",
        "vault_owner_token"
      ],
      "risk_level": "low",
      "execution_policy": "allow_direct",
