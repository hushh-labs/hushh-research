{
  "inputs": [
    {
      "id": "hushh-wiki-token",
      "type": "promptString",
      "description": "Hushh Wiki MCP bearer token (HCT:...)",
      "password": true
    }
  ],
  "servers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "hushh-wiki": {
      "type": "http",
      "url": "https://mcp.hushh.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${input:hushh-wiki-token}"
      }
    }
  }
}
