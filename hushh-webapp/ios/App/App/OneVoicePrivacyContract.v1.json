{
  "protocol_version": "one.voice.privacy-contract.v1",
  "app_store_declaration_contract_version": "one-voice-privacy-v1",
  "voice_capture": {
    "audio_storage": "memory_only",
    "transcript_storage": "memory_only",
    "transcription": "bounded_managed_gemini_audio",
    "provider_fallback": "forbidden",
    "generated_audio": "forbidden",
    "maximum_duration_seconds": 60
  },
  "model_packs": {
    "base_bundle_weights": "forbidden",
    "download": "retired"
  },
  "required_info_plist_keys": [
    "NSMicrophoneUsageDescription"
  ],
  "required_privacy_manifest": {
    "tracking": false
  }
}
