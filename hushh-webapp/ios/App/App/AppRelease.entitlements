<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Production entitlements for App Store / public-release builds.

  Identical to App.entitlements EXCEPT aps-environment = production, so the
  released binary registers for the Apple Push Notification *production*
  gateway. TestFlight also uses the production APNs gateway. App.entitlements
  keeps development APNs for local `npm run ios:run` and Xcode debug installs.

  This is the production entitlement reference. Distribution workflows keep
  target-owned automatic signing with App.entitlements while archiving, then
  let App Store Connect export re-sign for distribution. The export helper
  verifies the real IPA's production APNs entitlement and provisioning profile
  before the existing Xcode upload flow. Do not force a global distribution
  signing identity or this entitlement source onto dependency/extension targets.
-->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:one.hushh.ai</string>
		<string>webcredentials:uat.one.hushh.ai</string>
		<string>webcredentials:dev.one.hushh.ai</string>
		<string>applinks:one.hushh.ai</string>
		<string>applinks:uat.one.hushh.ai</string>
		<string>applinks:dev.one.hushh.ai</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
		<string>$(AppIdentifierPrefix)com.hushh.app.imessage</string>
		<string>$(AppIdentifierPrefix)com.hussh.app.chatnotifications</string>
	</array>
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
</dict>
</plist>
