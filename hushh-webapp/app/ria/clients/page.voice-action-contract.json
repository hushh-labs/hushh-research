      "control_ids": [
        "ria_clients_view_switch"
      ],
      "state_exposure": [
        "selected clients view"
      ],
      "docs_references": [
        "hushh-webapp/app/ria/clients/page.tsx",
        "hushh-webapp/components/ria/nearby/nearby-around-you.tsx"
      ],
      "speaker_persona": "one"
    },
    {
      "action_id": "ria.clients.nearby_shortlist_record",
      "label": "Shortlist Nearby Record",
      "meaning": "Represents the shortlist control on an opened public-association record. Choosing a specific record stays manual until voice carries a selected record id.",
      "aliases": [
        "shortlist this person",
        "save this record",
        "add to my shortlist"
      ],
      "search_keywords": [
        "shortlist",
        "save",
        "prospect"
      ],
      "reachability": {
        "routes": [
          "/ria/clients"
        ],
        "screens": [
          "ria_clients"
        ],
        "hidden_navigable": false,
        "navigation_prerequisites": [
          "A public-association record must be open."
        ],
        "active_personas": [
          "ria"
        ]
      },
      "guard_ids": [
        "auth_signed_in",
        "ria_persona_available",
        "manual_user_execution"
      ],
      "risk_level": "medium",
      "execution_policy": "manual_only",
      "execution_target": {
        "status": "unwired",
        "reason": "Shortlisting requires a person id from the opened record.",
        "intended_handler": "NwsNearbyService.shortlist"
      },
      "control_ids": [
        "ria_clients_nearby_shortlist"
      ],
      "state_exposure": [
        "visible public record names",
        "shortlisted state"
      ],
      "docs_references": [
        "hushh-webapp/components/ria/nearby/nearby-record-sheet.tsx",
        "hushh-webapp/lib/services/nws-nearby-service.ts"
      ],
      "speaker_persona": "kai"
    }
  ]
}
