        "hushh-webapp/app/ria/clients/page.tsx",
        "hushh-webapp/lib/navigation/routes.ts"
      ],
      "speaker_persona": "kai"
    },
    {
      "action_id": "ria.clients.switch_to_nearby",
      "label": "Show People Around You",
      "meaning": "Switches the clients screen from the connected roster to public-association records near a chosen location.",
      "aliases": [
        "show people around me",
        "switch to around you",
        "open nearby records"
      ],
      "search_keywords": [
        "around you",
        "nearby",
        "prospects",
        "public records"
      ],
      "reachability": {
        "routes": [
          "/ria/clients"
        ],
        "screens": [
          "ria_clients"
        ],
        "hidden_navigable": false,
        "navigation_prerequisites": [
          "RIA onboarding must be complete."
        ],
        "active_personas": [
          "ria"
        ]
      },
      "guard_ids": [
        "auth_signed_in",
        "ria_persona_available"
      ],
      "risk_level": "low",
      "execution_policy": "allow_direct",
      "execution_target": {
        "status": "wired",
        "path": "control",
        "target": "ria_clients_view_switch"
