            "name": "phone_number",
            "prompt": "What's your phone number, including country code?",
            "required": true,
            "slot": "phoneNumber"
          }
        ]
      }
    },
    {
      "action_id": "phone_mandate.submit_code",
      "label": "Submit Verification Code",
