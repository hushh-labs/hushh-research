        "analyze stock",
        "start stock analysis",
        "research stock"
      ],
      "search_keywords": [
        "analyze",
        "analysis",
        "stock"
      ],
      "reachability": {
        "routes": [
          "/one/kai?tab=analysis"
        ],
        "screens": [
          "kai_analysis"
        ],
        "hidden_navigable": false,
        "navigation_prerequisites": []
