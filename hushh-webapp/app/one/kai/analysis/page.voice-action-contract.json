          {
            "name": "pick_source",
            "slot": "pickSource",
            "resolver": "kai_pick_source",
            "prompt": "Which list should One use for this debate?",
            "default_value": "default",
            "options": [
              "default"
            ]
          }
        ],
        "input_resolvers": [
          "ticker_symbol",
          "kai_pick_source"
        ],
        "slot_schema": {
          "symbol": "ticker_symbol",
          "pickSource": "kai_pick_source"
        },
        "workflow_steps": [
          {
            "type": "action",
            "action_id": "analysis.start",
            "label": "Open stock analysis preview",
            "failure_behavior": "stop",
            "settlement_target": {
              "route": "/one/kai?tab=analysis",
              "screen": "kai_analysis"
            }
          }
        ],
        "progress_contract": {
          "mode": "milestone",
          "milestone_events": [
            "started",
            "agent_complete",
            "decision"
          ]
        },
        "cancellation_contract": {
          "cancellable": true,
          "cancel_action_id": "analysis.cancel_active"
