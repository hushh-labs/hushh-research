  "actions": [
    { "action_id": "route.one_connect", "label": "Open Connect", "meaning": "Opens Connect, where you find people, send connection requests and manage who you are connected to.", "aliases": ["open connect", "connect", "find people", "add people", "add a connection", "connect with someone"], "search_keywords": ["connect", "connections", "people", "add", "find", "invite"], "reachability": { "routes": ["/one/connect"], "screens": ["connect", "one_location", "one_agents", "one_pkm"], "hidden_navigable": false, "navigation_prerequisites": [] }, "guard_ids": ["auth_signed_in"], "risk_level": "low", "execution_policy": "allow_direct", "execution_target": { "status": "wired", "path": "route", "target": "/one/connect" }, "control_ids": [], "state_exposure": ["connection count"] },
    { "action_id": "connect.open_people", "label": "Open Connect people", "meaning": "Shows the People tab, which lists your connections and lets you search everyone you could connect with.", "aliases": ["people tab", "connect people", "my connections", "who am i connected to"], "search_keywords": ["people", "connections", "directory"], "reachability": { "routes": ["/one/connect"], "screens": ["connect"], "hidden_navigable": false, "navigation_prerequisites": [] }, "guard_ids": ["auth_signed_in"], "risk_level": "low", "execution_policy": "allow_direct", "execution_target": { "status": "wired", "path": "local_handler", "target": "connect.open_people" }, "control_ids": [], "state_exposure": ["active connect tab", "connection count"], "goal": { "goal_id": "goal.connect.open_people", "workflow_steps": [{ "type": "action", "action_id": "connect.open_people", "label": "Open Connect people", "settlement_target": { "route": "/one/connect", "screen": "connect" } }] } },
    { "action_id": "connect.open_nearby", "label": "Open advisors around you", "meaning": "Shows the Around you tab, which finds advisors near your current location.", "aliases": ["around you", "nearby", "advisors near me", "who is nearby", "nearby advisors"], "search_keywords": ["nearby", "around", "advisors", "near me"], "reachability": { "routes": ["/one/connect"], "screens": ["connect"], "hidden_navigable": false, "navigation_prerequisites": ["Device location permission is granted."] }, "guard_ids": ["auth_signed_in"], "risk_level": "low", "execution_policy": "allow_direct", "execution_target": { "status": "wired", "path": "local_handler", "target": "connect.open_nearby" }, "control_ids": [], "state_exposure": ["active connect tab"], "goal": { "goal_id": "goal.connect.open_nearby", "workflow_steps": [{ "type": "action", "action_id": "connect.open_nearby", "label": "Open advisors around you", "settlement_target": { "route": "/one/connect", "screen": "connect" } }] } },
    { "action_id": "connect.search_people", "label": "Search for someone to connect with", "meaning": "Searches Connect's people directory for the name you say. It only shows matches; sending or accepting a connection request remains a separate confirmed action. Use this only when the person wants to browse or look someone up without connecting yet. If the goal is to send a connection request and a name is already spoken (e.g. 'connect with Sarah'), call send_request directly instead -- it resolves the name itself and does not need this run first.", "aliases": ["search people", "find someone", "look someone up", "search for a person"], "search_keywords": ["search", "find", "people", "name"], "reachability": { "routes": ["/one/connect"], "screens": ["connect"], "hidden_navigable": false, "navigation_prerequisites": [] }, "guard_ids": ["auth_signed_in"], "risk_level": "low", "execution_policy": "allow_direct", "execution_target": { "status": "wired", "path": "local_handler", "target": "connect.search_people" }, "control_ids": ["one-connect-search"], "state_exposure": ["active connect tab", "directory result count"], "goal": { "goal_id": "goal.connect.search_people", "slot_schema": { "person": "spoken_person_name" }, "required_inputs": [{ "name": "person", "slot": "person", "resolver": "spoken_person_name", "prompt": "Who should I look for in Connect?", "required": true }], "workflow_steps": [{ "type": "action", "action_id": "connect.search_people", "label": "Search for someone to connect with", "settlement_target": { "route": "/one/connect", "screen": "connect" } }] } },
    { "action_id": "connect.send_request", "label": "Send a connection request", "meaning": "Sends a no-scope connection request to one or more exact directory matches after the person confirms it by voice -- multiple people can be named in one turn, e.g. 'Alice and Bob'. It never guesses between people with the same or a similar name. Say a name and this handles the rest hands-free: it searches the directory and matches the name itself. Call it directly the moment a name is spoken (e.g. 'connect with Sarah', 'send a request to Priya Singh') -- there is no need to open or run search_people first, and the person never has to type anything; if more than one match shares a spoken name, a tap-to-pick card settles it, not typing. A nameless request like 'connect with someone' or 'add a connection' has nothing to search for -- that means open Connect (route.one_connect), not this.", "aliases": ["send a connection request", "invite someone", "send a request to"], "search_keywords": ["connect", "request", "invite", "add", "person"], "reachability": { "routes": ["/one/connect"], "screens": ["connect"], "hidden_navigable": false, "navigation_prerequisites": [] }, "guard_ids": ["auth_signed_in"], "risk_level": "high", "execution_policy": "confirm_required", "execution_target": { "status": "wired", "path": "local_handler", "target": "connect.send_request" }, "control_ids": [], "state_exposure": ["connection count"], "goal": { "goal_id": "goal.connect.send_request", "slot_schema": { "person": "spoken_person_name_list" }, "required_inputs": [{ "name": "person", "slot": "person", "resolver": "spoken_person_name_list", "prompt": "Who should receive the connection request?", "required": true }], "workflow_steps": [{ "type": "action", "action_id": "connect.send_request", "label": "Send a connection request", "settlement_target": { "route": "/one/connect", "screen": "connect" } }] } },
    {"action_id": "connect.cancel_request", "label": "Cancel a connection request you sent", "meaning": "Withdraws connection requests you already sent to the named people, before they have accepted -- multiple people can be named in one turn, e.g. 'Alice and Bob'. It does not affect anyone who is already connected to you.", "aliases": ["cancel my request", "withdraw my request", "take back my connection request", "never mind that request"], "search_keywords": ["cancel", "withdraw", "request", "pending", "connection"], "reachability": {"routes": ["/one/connect"], "screens": ["connect"], "hidden_navigable": false, "navigation_prerequisites": []}, "guard_ids": ["auth_signed_in"], "risk_level": "medium", "execution_policy": "confirm_required", "execution_target": {"status": "wired", "path": "local_handler", "target": "connect.cancel_request"}, "control_ids": [], "state_exposure": ["pending outgoing request count"], "goal": {"goal_id": "goal.connect.cancel_request", "slot_schema": {"person": "spoken_person_name_list"}, "required_inputs": [{"name": "person", "slot": "person", "resolver": "spoken_person_name_list", "prompt": "Whose request should I cancel?", "required": true}], "workflow_steps": [{"type": "action", "action_id": "connect.cancel_request", "label": "Cancel a connection request you sent", "settlement_target": {"route": "/one/connect", "screen": "connect"}}]}},
    {"action_id": "connect.accept_request", "label": "Accept a connection request", "meaning": "Accepts pending connection requests you already received from the named people, before you have accepted -- multiple people can be named in one turn, e.g. 'Alice and Bob'. Forms a real, mutual connection once accepted. If the person you named already sent you a request instead of the other way around, this is the action that connects with them -- send_request would refuse and point here.", "aliases": ["accept their connection request", "accept the connection request from", "connect back with", "accept their request to connect"], "search_keywords": ["accept", "connection", "request", "pending", "incoming"], "reachability": {"routes": ["/one/feed"], "screens": ["one_feed"], "hidden_navigable": false, "navigation_prerequisites": []}, "guard_ids": ["auth_signed_in"], "risk_level": "high", "execution_policy": "confirm_required", "execution_target": {"status": "wired", "path": "local_handler", "target": "connect.accept_request"}, "control_ids": [], "state_exposure": ["pending incoming request count"], "goal": {"goal_id": "goal.connect.accept_request", "slot_schema": {"person": "spoken_person_name_list"}, "required_inputs": [{"name": "person", "slot": "person", "resolver": "spoken_person_name_list", "prompt": "Whose request should I accept?", "required": true}], "workflow_steps": [{"type": "action", "action_id": "connect.accept_request", "label": "Accept a connection request", "settlement_target": {"route": "/one/feed", "screen": "one_feed"}}]}},
