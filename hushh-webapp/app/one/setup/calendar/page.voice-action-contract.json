{
  "schema_version": "kai.local_action_contract.v1",
  "surface_id": "one_setup_calendar",
  "surface_title": "Calendar Setup",
  "docs_references": [
    "docs/reference/quality/one-onboarding-architecture.md",
    "docs/reference/one/one-voice-runtime-architecture.md"
  ],
  "defaults": {
    "reachability": {
      "active_personas": ["investor", "ria"]
    },
    "speaker_persona": "one",
    "guard_ids": ["auth_signed_in"]
  },
  "actions": [
    {
      "action_id": "setup.connect_calendar",
      "label": "Connect Calendar",
      "meaning": "Presents the exact Calendar connection action so a confirming tap can start Google Calendar authorization.",
      "aliases": ["connect calendar", "connect my calendar", "set up calendar"],
      "search_keywords": ["connect", "calendar", "schedule"],
      "reachability": {
        "routes": ["/one/setup/calendar"],
        "screens": ["one_setup_calendar"],
        "hidden_navigable": false,
        "navigation_prerequisites": []
      },
      "guard_ids": ["auth_signed_in"],
      "risk_level": "low",
      "execution_policy": "allow_direct",
      "activation_policy": "trusted_activation_required",
      "execution_target": {
        "status": "wired",
        "path": "local_handler",
        "target": "setup.connect_calendar"
      },
      "control_ids": ["open_calendar_connector"],
      "state_exposure": ["calendar connection state", "active setup capability"],
      "docs_references": [
        "components/calendar/calendar-agent-page.tsx",
        "app/one/setup/calendar/calendar-onboarding-setup-client.tsx"
      ]
    },
    {
      "action_id": "setup.finish_calendar",
      "label": "Finish Calendar setup",
      "meaning": "Records an already verified Calendar connection as complete and returns to the setup hub.",
      "aliases": ["finish calendar setup", "finish calendar", "complete calendar setup"],
      "search_keywords": ["finish", "calendar", "complete"],
      "reachability": {
        "routes": ["/one/setup/calendar"],
        "screens": ["one_setup", "one_setup_calendar"],
        "hidden_navigable": false,
        "navigation_prerequisites": []
      },
      "guard_ids": ["auth_signed_in"],
      "risk_level": "low",
      "execution_policy": "allow_direct",
      "execution_target": {
        "status": "wired",
        "path": "local_handler",
        "target": "setup.finish_calendar"
      },
      "control_ids": ["finish_calendar_setup"],
      "state_exposure": ["calendar connection state", "active setup capability"],
      "docs_references": [
        "app/one/setup/calendar/calendar-onboarding-setup-client.tsx",
        "components/onboarding/setup/setup-completion-footer.tsx"
      ]
    },
    {
      "action_id": "setup.skip_calendar",
      "label": "Skip Calendar setup",
      "meaning": "Leaves Calendar setup and returns to the setup hub without recording Calendar as complete.",
      "aliases": ["skip calendar setup", "skip calendar", "not now"],
      "search_keywords": ["skip", "calendar", "not now"],
      "reachability": {
        "routes": ["/one/setup/calendar"],
        "screens": ["one_setup", "one_setup_calendar"],
        "hidden_navigable": false,
        "navigation_prerequisites": []
      },
      "guard_ids": ["auth_signed_in"],
      "risk_level": "low",
      "execution_policy": "allow_direct",
      "execution_target": {
        "status": "wired",
        "path": "local_handler",
        "target": "setup.skip_calendar"
      },
      "control_ids": ["skip_calendar_setup"],
      "state_exposure": ["calendar connection state", "active setup capability"],
      "docs_references": [
        "app/one/setup/calendar/calendar-onboarding-setup-client.tsx",
        "components/onboarding/setup/setup-completion-footer.tsx"
      ]
    }
  ]
}
