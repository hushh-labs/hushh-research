{
  "schema_version": "kai.local_action_contract.v1",
  "surface_id": "one_kyc",
  "surface_title": "KYC",
  "docs_references": [
    "docs/reference/kai/kai-action-gateway-vnext.md",
    "docs/reference/architecture/one-email-kyc.md",
    "docs/reference/architecture/frontend-native-surface-map.md"
  ],
  "defaults": {
    "reachability": {
      "routes": ["/one/kyc"],
      "screens": ["one_kyc"],
      "active_personas": ["investor"],
      "navigation_prerequisites": ["user must be signed in"]
    },
    "speaker_persona": "kyc",
    "delegate_agent_id": "agent_kyc"
  },
  "actions": [
    {
      "action_id": "route.one_kyc",
      "label": "Open KYC",
      "meaning": "Navigates to One's approval-gated request review.",
      "aliases": [
        "open kyc",
        "open email",
        "open email helper",
        "show email requests",
        "show requests"
      ],
      "search_keywords": ["email", "one", "request"],
      "reachability": {
        "hidden_navigable": false
      },
      "guard_ids": ["auth_required", "vault_unlocked"],
      "risk_level": "low",
      "execution_policy": "allow_direct",
      "execution_target": {
        "status": "wired",
        "path": "route",
        "target": "/one/kyc"
      },
      "control_ids": ["one-kyc-open", "top_agent_section_email"],
      "state_exposure": ["workflow list metadata only"]
    },
    {
      "action_id": "kyc.aliases.manage",
      "label": "Manage verified addresses",
      "meaning": "Opens the verified address panel used to match incoming requests.",
      "aliases": [
        "manage verified addresses",
        "manage verified emails",
        "add email address",
        "show matching emails"
      ],
      "search_keywords": ["email", "address", "match"],
      "guard_ids": ["auth_required"],
      "risk_level": "medium",
      "execution_policy": "manual_only",
      "execution_target": {
        "status": "unwired",
        "reason": "Requires opening the local verified address panel in /one/kyc."
      },
      "control_ids": ["one-kyc-aliases"],
      "state_exposure": ["verified address count", "pending address count"]
    },
    {
      "action_id": "kyc.workflow.sync_status",
      "label": "Sync request status",
      "meaning": "Refreshes the selected request status after consent approval.",
      "aliases": ["sync email", "refresh request status"],
      "search_keywords": ["email", "sync", "consent"],
      "guard_ids": ["auth_required"],
      "risk_level": "medium",
      "execution_policy": "manual_only",
      "execution_target": {
        "status": "unwired",
        "reason": "Requires selected workflow context from /one/kyc."
      },
      "control_ids": ["one-kyc-sync-status"],
      "state_exposure": ["workflow status metadata"]
    },
    {
      "action_id": "kyc.draft.review",
      "label": "Review response draft",
      "meaning": "Reads or focuses the current approval-gated response draft.",
      "aliases": ["review email draft", "show email draft"],
      "search_keywords": ["email", "draft", "review"],
      "guard_ids": ["auth_required"],
      "risk_level": "medium",
      "execution_policy": "manual_only",
      "execution_target": {
        "status": "unwired",
        "reason": "Requires selected workflow context and user-visible draft state."
      },
      "control_ids": ["one-kyc-draft-review"],
      "state_exposure": ["approved draft body"]
    },
    {
      "action_id": "kyc.draft.request_redraft",
      "label": "Request response revision",
      "meaning": "Requests a new response draft revision from typed or spoken user instructions.",
      "aliases": ["redraft email", "revise email draft"],
      "search_keywords": ["email", "redraft", "revise"],
      "guard_ids": ["auth_required", "vault_unlocked"],
      "risk_level": "medium",
      "execution_policy": "confirm_required",
      "execution_target": {
        "status": "wired",
        "path": "local_handler",
        "target": "one_kyc_redraft"
      },
      "control_ids": ["one-kyc-redraft"],
      "state_exposure": ["approved draft body", "redraft instructions"],
      "goal": {
        "required_inputs": [
          {
            "name": "instruction",
            "slot": "instruction",
            "prompt": "How should I revise the current response draft?",
            "required": true
          }
        ]
      }
    },
    {
      "action_id": "kyc.draft.approve_send",
      "label": "Approve response",
      "meaning": "Sends the response draft only after explicit user approval.",
      "aliases": ["approve email send", "send email reply"],
      "search_keywords": ["email", "send", "approve"],
      "guard_ids": ["auth_required", "explicit_confirmation_required"],
      "risk_level": "high",
      "execution_policy": "manual_only",
      "execution_target": {
        "status": "unwired",
        "reason": "Voice must not send a response until the selected workflow and explicit confirmation are wired to the same UI approval endpoint."
      },
      "control_ids": ["one-kyc-approve-send"],
      "state_exposure": ["approved draft body", "send status"]
    },
    {
      "action_id": "kyc.draft.reject",
      "label": "Reject response draft",
      "meaning": "Rejects the current response draft and blocks the workflow.",
      "aliases": ["reject email draft", "block email request"],
      "search_keywords": ["email", "reject", "block"],
      "guard_ids": ["auth_required"],
      "risk_level": "medium",
      "execution_policy": "confirm_required",
      "execution_target": {
        "status": "unwired",
        "reason": "Requires selected workflow context from /one/kyc."
      },
      "control_ids": ["one-kyc-reject"],
      "state_exposure": ["workflow status metadata"]
    }
  ]
}
