{
  "schema_version": "kai.local_action_contract.v1",
  "surface_id": "one_calendar",
  "surface_title": "Calendar",
  "docs_references": [
    "docs/reference/one/one-calendar-knowledge-graph.md",
    "docs/reference/one/one-voice-runtime-architecture.md"
  ],
  "defaults": {
    "speaker_persona": "one",
    "reachability": {
      "active_personas": [
        "investor",
        "ria"
      ],
      "routes": [
        "/one/calendar",
        "/one"
      ],
      "screens": [
        "one_calendar",
        "one_agents"
      ],
      "hidden_navigable": true,
      "navigation_prerequisites": [
        "Open /one/calendar only when the owner asks to see the Calendar page."
      ]
    }
  },
  "actions": [
    {
      "action_id": "calendar.read",
      "label": "Read Calendar",
      "meaning": "Reads the owner's connected Google Calendar through One Live Voice. The read can list calendars, find events in a bounded time window, open a previously shown event, inspect busy periods, or find openings. Event text is displayed privately on screen; the operational voice model receives only counts and status. No event is created or changed.",
      "aliases": [
        "what is on my calendar",
        "show my calendar events",
        "find a calendar event",
        "when am i free"
      ],
      "search_keywords": [
        "calendar events",
        "calendar list",
        "event details",
        "busy times",
        "free openings"
      ],
      "guard_ids": [
        "auth_signed_in",
        "vault_owner_token"
      ],
      "risk_level": "low",
      "execution_policy": "allow_direct",
      "execution_target": {
        "status": "wired",
        "path": "voice_tool",
        "target": "read_calendar"
      },
      "control_ids": [],
      "state_exposure": [
        "calendar_connection_state",
        "vault_ready"
      ],
      "docs_references": [
        "consent-protocol/hushh_mcp/one_voice/tools/calendar.py",
        "consent-protocol/hushh_mcp/services/google_calendar_service.py"
      ]
    },
    {
      "action_id": "calendar.invitation.review",
      "label": "Review Calendar invitations",
      "meaning": "Continues the owner’s invitation request inside the existing One Chat conversation. It can show pending invitations or prepare accept, decline, and alternate-time reviews. This handoff changes no RSVP and sends no Mail; the shared Calendar review requires an explicit browser confirmation.",
      "aliases": [
        "show my pending invitations",
        "accept tomorrow’s client meeting",
        "decline my 3 PM invitation",
        "I cannot attend ask the organizer to choose another time"
      ],
      "search_keywords": [
        "calendar invitations",
        "RSVP",
        "accept invitation",
        "decline invitation",
        "offer another time"
      ],
      "reachability": {
        "active_personas": [
          "investor",
          "ria"
        ],
        "routes": [
          "/",
          "/one",
          "/one/calendar"
        ],
        "screens": [
          "chat",
          "one_agents",
          "calendar"
        ],
        "hidden_navigable": true,
        "navigation_prerequisites": [
          "Keep the existing One Chat conversation; do not open Calendar for an invitation action."
        ]
      },
      "guard_ids": [
        "auth_signed_in",
        "vault_owner_token"
      ],
      "risk_level": "low",
      "execution_policy": "allow_direct",
      "execution_target": {
        "status": "wired",
        "path": "voice_tool",
        "target": "continue_calendar_in_chat"
      },
      "control_ids": [
        "calendar_invitation_accept",
        "calendar_invitation_decline",
        "calendar_invitation_offer"
      ],
      "state_exposure": [
        "calendar_connection_state",
        "vault_ready"
      ],
      "goal": {
        "required_inputs": [
          {
            "name": "request",
            "slot": "request",
            "prompt": "What would you like to do with the invitation?",
            "required": true,
            "resolver": "user_utterance"
          }
        ],
        "input_resolvers": [
          "user_utterance"
        ],
        "slot_schema": {
          "request": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "workflow_steps": [
          {
            "type": "tool_call",
            "label": "Continue invitation review in One Chat",
            "service": "frontend.calendar.invitation.review",
            "failure_behavior": "stop"
          }
        ]
      }
    }
  ],
  "search": {}
}
