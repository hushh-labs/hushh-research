  "impact_fields": [
    "Mutation authority recorded",
    "Routes and session boundaries recorded",
    "No secret-bearing artifacts produced",
    "Verification commands executed"
  ],
  "handoff_chain": [
    "security-audit",
    "reviewer-app-testing",
    "vault-pkm-governance",
    "pkm-upgrade-rehearsal"
  ],
  "common_failures": [
    "Using page.goto or reload inside a flow that claims same-session key continuity",
