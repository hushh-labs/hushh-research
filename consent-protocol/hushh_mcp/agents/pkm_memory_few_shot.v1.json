    {
      "id": "segmentation_duplicate_and_disclaimer",
      "agent": "agent_memory_segmentation",
      "teaches": "exact quotes with Markdown kept; a repeat is duplicate; an unknown-only line is disclaimer",
      "exercised_by": [
        "document:Vendors",
        "document:Information not known"
      ],
      "input": {
        "message": "## Stack\n- **Backend:** FastAPI on Cloud Run\n- Backend: FastAPI on Cloud Run\n- Information not known: team size"
      },
      "answer": {
        "segments": [
          {
            "source_text": "- **Backend:** FastAPI on Cloud Run",
            "context_quotes": [
              "## Stack"
            ],
            "confidence": 0.95,
            "reason": "stack fact"
          }
        ],
        "not_memory": [
          {
            "quote": "- Backend: FastAPI on Cloud Run",
            "reason": "duplicate"
          },
          {
            "quote": "- Information not known: team size",
            "reason": "disclaimer"
          }
        ],
        "has_more_candidates": false
      }
    },
