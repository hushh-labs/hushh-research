# Backend Environment Variables Template
# Copy this to .env.backend and fill in production values

# ============================================================================
# PRODUCTION CONFIGURATION
# ============================================================================

# Environment
ENVIRONMENT=production
PORT=8080
OTEL_ENABLED=false

# Frontend URL (UPDATE AFTER FRONTEND DEPLOYMENT)
# This is used for CORS configuration
FRONTEND_URL=https://hushh-webapp-XXXXXXXXXX-uc.a.run.app
# Comma-separated explicit origin allowlist (no wildcard regex in regulated mode)
CORS_ALLOWED_ORIGINS=https://hushh-webapp-XXXXXXXXXX-uc.a.run.app

# ============================================================================
# SECRETS (Managed via Google Cloud Secret Manager)
# ============================================================================
# DO NOT set these here - they are injected from Secret Manager
# Listed here for documentation purposes only

# SECRET_KEY=<at least 32 chars; 64-char hex recommended — matches hushh_mcp/config.py>
# VAULT_ENCRYPTION_KEY=<exactly 64-char hex — matches hushh_mcp/config.py>
# GOOGLE_API_KEY=<Google Gemini API key>
# FIREBASE_SERVICE_ACCOUNT_JSON=<Firebase Admin SDK JSON>
# DB_USER=<Supabase pooler username, e.g., postgres.project-ref>
# DB_PASSWORD=<Database password>
# FINNHUB_API_KEY=<Finnhub API key>
# PMP_API_KEY=<PMP/FMP API key>
# FMP_API_KEY=<FMP API key (optional alias)>
# IAPD_VERIFY_BASE_URL=<Official advisory verification worker base URL>
# IAPD_VERIFY_API_KEY=<Official advisory verification worker API key>
# Stage 1 RIA intelligence verifier (runtime env vars; not secrets):
# RIA_INTELLIGENCE_VERIFY_BASE_URL=https://hushh-ria-intelligence-api-53407187172.us-central1.run.app
# RIA_INTELLIGENCE_VERIFY_ENDPOINT_PATH=/v1/ria/profile/stage1
# RIA_INTELLIGENCE_VERIFY_URL=<Optional full Stage 1 override; leave blank when using base URL + endpoint path>
# Optional intelligence verifier secret when the service is protected:
# RIA_INTELLIGENCE_VERIFY_API_KEY=<Bearer token if intelligence API is protected>
# RIA_INTELLIGENCE_VERIFY_TIMEOUT_SECONDS=60

# ============================================================================
# DATABASE CONFIGURATION (Supabase Session Pooler)
# ============================================================================
# Uses individual DB_* environment variables for Supabase connection pooling
# DB_HOST, DB_PORT, DB_NAME are set as Cloud Run env vars (not secrets)
# DB_USER and DB_PASSWORD are injected from Secret Manager
#
# Example values:
# DB_HOST=aws-1-us-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres

# ============================================================================
# TOKEN EXPIRATION (milliseconds)
# ============================================================================
DEFAULT_CONSENT_TOKEN_EXPIRY_MS=604800000    # 7 days
DEFAULT_TRUST_LINK_EXPIRY_MS=2592000000      # 30 days

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================
AGENT_ID=agent_hushh_production
HUSHH_HACKATHON=disabled

# ============================================================================
# APP REVIEW MODE (BACKEND RUNTIME CONFIG)
# ============================================================================
# Local/developer fallback only. In production, APP_REVIEW_MODE is sourced from Secret Manager.
APP_REVIEW_MODE=false
# REVIEWER_UID is required when APP_REVIEW_MODE=true
# REVIEWER_UID=firebase-uid-for-reviewer

# Regulated defaults
CONSENT_SSE_ENABLED=false
SYNC_REMOTE_ENABLED=false
DEVELOPER_API_ENABLED=false
OBS_DATA_STALE_RATIO_THRESHOLD=0.25

# Non-production only: runtime registry for /api/v1 developer API
# DEVELOPER_REGISTRY_JSON={"mcp_dev_local":{"name":"MCP Local","approved_scopes":["*"]}}

# Service auth for protected lookup endpoints
# HUSHH_DEVELOPER_TOKEN=<high-entropy developer token>

# ============================================================================
# PLAID + ALPACA FUNDING RUNTIME (HOSTED KAI)
# ============================================================================
# Plaid credentials/encryption keys stay in Secret Manager:
# PLAID_CLIENT_ID
# PLAID_SECRET
# PLAID_TOKEN_ENCRYPTION_KEY
# Real-bank Plaid lanes use PLAID_ENV=production for both Limited Production/trial
# and full production. Kai does not treat a separate development host as a
# hosted real-bank lane.
PLAID_ENV=production
PLAID_CLIENT_NAME=Hushh Kai
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=https://kai.hushh.ai/api/kai/plaid/webhook
PLAID_REDIRECT_PATH=/kai/plaid/oauth/return
PLAID_REDIRECT_URI=https://kai.hushh.ai/kai/plaid/oauth/return
PLAID_TX_HISTORY_DAYS=730

# Alpaca funding secrets stay in Secret Manager:
# ALPACA_CONNECT_CLIENT_ID
# ALPACA_CONNECT_CLIENT_SECRET
# FUNDING_SECRET_ENCRYPTION_KEY
# and one Broker auth option:
# ALPACA_BROKER_CLIENT_ID + ALPACA_BROKER_CLIENT_SECRET
# or:
# ALPACA_BROKER_AUTH_TOKEN
# or ALPACA_BROKER_KEY_ID + ALPACA_BROKER_SECRET
# hosted deploy compatibility:
# ALPACA_API_KEY -> runtime ALPACA_BROKER_KEY_ID
# ALPACA_API_SECRET -> runtime ALPACA_BROKER_SECRET
# ALPACA_ENV uses sandbox|live for Broker API selection and still accepts production as a compatibility alias.
# ALPACA_CONNECT_ENV uses paper|live for the Connect authorize hint.
ALPACA_ENV=live
ALPACA_BROKER_BASE_URL=
ALPACA_DEFAULT_ACCOUNT_ID=
ALPACA_CONNECT_REDIRECT_URI=https://kai.hushh.ai/kai/alpaca/oauth/return
ALPACA_CONNECT_AUTHORIZE_URL=https://app.alpaca.markets/oauth/authorize
ALPACA_CONNECT_TOKEN_URL=https://api.alpaca.markets/oauth/token
ALPACA_CONNECT_ACCOUNT_URL=https://api.alpaca.markets/v2/account
ALPACA_CONNECT_SCOPES=account:write trading
ALPACA_CONNECT_ENV=live
ALPACA_CONNECT_STATE_TTL_SECONDS=900

# ============================================================================
# NOTES
# ============================================================================
# 1. Secrets are managed via Google Cloud Secret Manager
# 2. Use scripts/ops/verify-env-secrets-parity.py to verify all secrets exist
# 3. DB_USER and DB_PASSWORD are injected from Secret Manager
# 4. DB_HOST, DB_PORT, DB_NAME are set as Cloud Run env vars
# 5. Update FRONTEND_URL after deploying frontend
