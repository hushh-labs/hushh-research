{
  "name": "obs_agent_chat_first_answer_ms",
  "description": "Backend first assistant answer timing; missing marks excluded; inspect coverage beside latency",
  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"__BACKEND_SERVICE__\" AND textPayload=~\"one_agent_chat_turn_complete .* first_answer_token_ms=[0-9]+ \"",
  "valueExtractor": "REGEXP_EXTRACT(textPayload, \" first_answer_token_ms=([0-9]+)\")",
  "bucketOptions": {
    "explicitBuckets": {
      "bounds": [
        0,
        50,
        100,
        200,
        500,
        1000,
        2000,
        4000,
        8000,
        15000,
        30000,
        60000,
        120000,
        200000
      ]
    }
  },
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "ms"
  }
}
