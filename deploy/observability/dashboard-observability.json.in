{
  "name": "projects/__PROJECT_ID__/dashboards/hushh-observability-managed",
  "displayName": "Hushh Observability (Managed)",
  "labels": {
    "managed_by": "repo_observability"
  },
  "gridLayout": {
    "columns": 2,
    "widgets": [
      {
        "title": "Backend Request Rate (req/s)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "__BACKEND_SERVICE__",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"__BACKEND_SERVICE__\" AND metric.type=\"run.googleapis.com/request_count\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE"
                  }
                },
                "unitOverride": "1/s"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Backend 5xx Rate (req/s)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "5xx",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"__BACKEND_SERVICE__\" AND metric.type=\"run.googleapis.com/request_count\" AND metric.label.\"response_code_class\"=\"5xx\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE"
                  }
                },
                "unitOverride": "1/s"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Short-read P95 Duration (ms)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "p95",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND metric.type=\"logging.googleapis.com/user/obs_short_read_duration_ms\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95"
                  }
                },
                "unitOverride": "ms"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Frontend Request Rate (req/s)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "__FRONTEND_SERVICE__",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"__FRONTEND_SERVICE__\" AND metric.type=\"run.googleapis.com/request_count\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_RATE"
                  }
                },
                "unitOverride": "1/s"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Unexpected Error Rate (log metric)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "unexpected",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/obs_unexpected_error_count\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                },
                "unitOverride": "1/s"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Data Health Anomaly Count",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "STACKED_BAR",
              "legendTemplate": "anomaly",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/obs_data_health_anomaly_count\"",
                  "aggregation": {
                    "alignmentPeriod": "900s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                }
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Cloud SQL Connections (all databases)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloudsql_database\" AND resource.label.\"database_id\"=\"__PROJECT_ID__:__SQL_INSTANCE__\" AND metric.type=\"cloudsql.googleapis.com/database/postgresql/num_backends\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                },
                "unitOverride": "1"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Backend Pool Wait P95 (ms)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND metric.type=\"logging.googleapis.com/user/obs_db_pool_wait_ms\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "crossSeriesReducer": "REDUCE_MAX"
                  }
                },
                "unitOverride": "ms"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Backend Pool Acquire Timeouts",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND metric.type=\"logging.googleapis.com/user/obs_db_pool_acquire_timeout_count\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_DELTA",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                },
                "unitOverride": "1"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Backend CPU P95 (%)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"__BACKEND_SERVICE__\" AND metric.type=\"run.googleapis.com/container/cpu/utilizations\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "crossSeriesReducer": "REDUCE_MAX"
                  }
                },
                "unitOverride": "%"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Backend Instances (active and idle)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"__BACKEND_SERVICE__\" AND metric.type=\"run.googleapis.com/container/instance_count\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX",
                    "crossSeriesReducer": "REDUCE_SUM"
                  }
                },
                "unitOverride": "1"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Backend Memory P95 (%)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"cloud_run_revision\" AND resource.label.\"service_name\"=\"__BACKEND_SERVICE__\" AND metric.type=\"run.googleapis.com/container/memory/utilizations\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95",
                    "crossSeriesReducer": "REDUCE_MAX"
                  }
                },
                "unitOverride": "%"
              },
              "targetAxis": "Y1"
            }
          ]
        }
      },
      {
        "title": "Scope Commerce: Backing and Liabilities (micro USD)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "attributed backing micro usd",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/attributed_backing_micro_usd\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            },
            {
              "plotType": "LINE",
              "legendTemplate": "liabilities micro usd",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/liabilities_micro_usd\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            },
            {
              "plotType": "LINE",
              "legendTemplate": "fee reserve micro usd",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/fee_reserve_micro_usd\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            },
            {
              "plotType": "LINE",
              "legendTemplate": "backing shortfall micro usd",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/backing_shortfall_micro_usd\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Scope Commerce: Recovery and Unallocated Costs (micro USD)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "recovery liabilities micro usd",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/recovery_liabilities_micro_usd\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            },
            {
              "plotType": "LINE",
              "legendTemplate": "unallocated processing cost micro usd",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/unallocated_processing_cost_micro_usd\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Scope Commerce: Unresolved Work",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "unresolved obligations",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/unresolved_obligations\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            },
            {
              "plotType": "LINE",
              "legendTemplate": "uncertain operations",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/uncertain_operations\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            },
            {
              "plotType": "LINE",
              "legendTemplate": "pending provider events",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/pending_provider_events\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            },
            {
              "plotType": "LINE",
              "legendTemplate": "pending transfer recoveries",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/pending_transfer_recoveries\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Scope Commerce: Oldest Due Retry (seconds)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "oldest due work seconds",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/oldest_due_work_seconds\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Scope Commerce: Receipt and Journal Failures",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "receipt failures",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/receipt_failures\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            },
            {
              "plotType": "LINE",
              "legendTemplate": "unbalanced journals",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/unbalanced_journals\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Scope Commerce: Provider Observation (micro USD)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "provider available micro usd",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/provider_available_micro_usd\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Scope Commerce: Verification and Worker Freshness (Unix seconds)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "provider observed timestamp",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/provider_observed_timestamp\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            },
            {
              "plotType": "LINE",
              "legendTemplate": "worker completed timestamp",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/worker_completed_timestamp\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "title": "Scope Commerce: Provider Observation Verified (1=yes)",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "provider observation verified",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "resource.type=\"global\" AND metric.type=\"custom.googleapis.com/hussh/scope_commerce/provider_observation_verified\" AND metric.labels.service_name=\"__BACKEND_SERVICE__\"",
                  "aggregation": {
                    "alignmentPeriod": "60s",
                    "perSeriesAligner": "ALIGN_MAX"
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}
