{
  "displayName": "[Managed] Auth Test Allowlist Health",
  "documentation": {
    "content": "The protected phone-test check failed or could not verify its source. When AUTH_PHONE_RUNTIME_HEALTH_ENABLED is true in that environment, the same check also requires a healthy serving-process phone-test configuration observation; while off, coverage remains list-only. Optional heartbeat coverage detects three hours without reports. Check Verify Protected Configuration and scripts/ops/verify_secret_list_invariants.py; inspect aggregate status/counts and optional runtime_status only. Restore a damaged list through secret_list_edit.py after reviewing the last good version, or inspect the deployed runtime configuration when runtime_status is unavailable. Never copy phone numbers, fixed OTPs, tokens or secret contents into logs or incident evidence. Neither intact lists nor runtime prerequisites prove a completed OTP/auth journey or SMS delivery. Runbook: deploy/observability/README.md#auth-availability",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": false,
  "notificationChannels": [],
  "userLabels": {
    "managed_by": "repo_observability",
    "scope": "auth",
    "incident_purpose": "diagnostic"
  },
  "conditions": [
    {
      "displayName": "Protected phone allowlist check failed or unavailable",
      "conditionThreshold": {
        "filter": "resource.type=\"global\" AND metric.type=\"logging.googleapis.com/user/obs_auth_allowlist_failure_count\"",
        "aggregations": [
          {
            "alignmentPeriod": "3600s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "trigger": {
          "count": 1
        }
      }
    },
    {
      "displayName": "Protected phone allowlist health missing for 3h",
      "conditionAbsent": {
        "filter": "resource.type=\"global\" AND metric.type=\"logging.googleapis.com/user/obs_auth_allowlist_health_count\"",
        "duration": "10800s",
        "aggregations": [
          {
            "alignmentPeriod": "3600s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "severity": "ERROR",
  "alertStrategy": {
    "notificationPrompts": [
      "OPENED",
      "CLOSED"
    ],
    "autoClose": "1800s"
  }
}
