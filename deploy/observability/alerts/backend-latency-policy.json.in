{
  "displayName": "[Managed] Backend P95 Latency High",
  "documentation": {
    "content": "P95 duration for bounded short-read GET routes crossed 2 seconds; streaming requests are excluded.\n\nInspect sustained short-read latency and database acquisition/query traces.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": [],
  "userLabels": {
    "managed_by": "repo_observability",
    "scope": "ops",
    "incident_purpose": "actionable"
  },
  "conditions": [
    {
      "displayName": "Short-read p95 > 2s (10m)",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_run_revision\" AND metric.type=\"logging.googleapis.com/user/obs_short_read_duration_ms\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_MAX"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 2000,
        "duration": "600s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "severity": "ERROR",
  "alertStrategy": {
    "notificationPrompts": [
      "OPENED",
      "CLOSED"
    ]
  }
}
