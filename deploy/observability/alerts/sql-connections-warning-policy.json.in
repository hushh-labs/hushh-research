{
  "displayName": "[Managed] Cloud SQL Connections Warning",
  "documentation": {
    "content": "Cloud SQL PostgreSQL connections across database labels exceed __SQL_CONNECTION_WARNING__; inspect deployment overlap and pool use.\n\nDiagnostic only: early capacity warning is investigated with the critical SQL capacity incident.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": false,
  "notificationChannels": [],
  "userLabels": {
    "managed_by": "repo_observability",
    "scope": "capacity",
    "incident_purpose": "diagnostic"
  },
  "conditions": [
    {
      "displayName": "Connections > __SQL_CONNECTION_WARNING__ (5m)",
      "conditionThreshold": {
        "filter": "resource.type=\"cloudsql_database\" AND resource.label.\"database_id\"=\"__PROJECT_ID__:__SQL_INSTANCE__\" AND metric.type=\"cloudsql.googleapis.com/database/postgresql/num_backends\"",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_MAX",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": __SQL_CONNECTION_WARNING__,
        "duration": "300s",
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "severity": "WARNING",
  "alertStrategy": {
    "notificationPrompts": [
      "OPENED",
      "CLOSED"
    ]
  }
}
