# deploy/kai-self-hosted/.env.example
#
# Copy to `.env` and fill in BEFORE running docker compose up.
# The .env file MUST stay out of git (covered by the repo's .gitignore).

# ---------------------------------------------------------------------------
# REQUIRED: Hushh consent / vault keys (generated for your deployment, not
# shared with anyone). 32-byte hex for VAULT_DATA_KEY, >= 32 chars for
# APP_SIGNING_KEY. Use a fresh secrets management tool in production --
# the values below are for LOCAL DEV ONLY.
# ---------------------------------------------------------------------------
APP_SIGNING_KEY=replace-with-32+char-secret-do-not-commit
VAULT_DATA_KEY=replace-with-64-hex-chars-aka-32-bytes-from-os.urandom-do-not-commit

# ---------------------------------------------------------------------------
# REQUIRED for vLLM: HuggingFace token with access to the chosen model.
# Default model is the AWQ-quantized Meta Llama 3.1 8B Instruct, which
# fits a single 24 GB GPU.
# ---------------------------------------------------------------------------
HF_TOKEN=hf_replace_with_your_token

# ---------------------------------------------------------------------------
# OPTIONAL: Override the default vLLM model + quantization.
#
# Recommended:
#   24 GB VRAM:   hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4 (default)
#   48 GB VRAM:   Qwen/Qwen2.5-14B-Instruct-AWQ
#   80 GB VRAM:   meta-llama/Meta-Llama-3.1-70B-Instruct-AWQ-INT4
# ---------------------------------------------------------------------------
KAI_VLLM_MODEL=hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4
KAI_VLLM_QUANTIZATION=awq_marlin
KAI_VLLM_MAX_MODEL_LEN=8192
KAI_VLLM_GPU_MEM_UTIL=0.9

# Optional: protect the vLLM endpoint with a real API key (recommended
# in shared environments). The Kai backend will pass this through.
KAI_VLLM_API_KEY=EMPTY

# ---------------------------------------------------------------------------
# OPTIONAL: Postgres password override. Default is local-dev-only.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=kai_local_only_change_me
