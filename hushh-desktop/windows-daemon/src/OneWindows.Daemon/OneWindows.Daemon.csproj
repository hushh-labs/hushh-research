<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OneWindows.Consent\OneWindows.Consent.csproj" />
    <ProjectReference Include="..\OneWindows.Mcp\OneWindows.Mcp.csproj" />
    <ProjectReference Include="..\OneWindows.Security\OneWindows.Security.csproj" />
    <ProjectReference Include="..\OneWindows.Npu\OneWindows.Npu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <!-- Ships the (gitignored, fetched via scripts/fetch-npu-model.ps1) model
       files next to the built exe, so they're found the same way in dev
       (bin/) and in a published build (publish/) without path guessing.
       If the model hasn't been fetched yet, this glob just matches nothing;
       ClassifyImageTool registration in Program.cs handles that case. -->
  <ItemGroup>
    <None Include="..\..\models\mobilenet_v2\**" CopyToOutputDirectory="PreserveNewest">
      <Link>models\mobilenet_v2\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
