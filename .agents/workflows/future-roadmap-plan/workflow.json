{
  "id": "future-roadmap-plan",
  "title": "Future Design Review",
  "goal": "Turn future-state product or architecture ideas into planning-only docs grounded in Hussh north stars, trust boundaries, and current repo reality.",
  "owner_skill": "future-planner",
  "default_spoke": null,
  "task_type": "future-roadmap-plan",
  "affected_surfaces": [
    "docs/roadmap",
    "docs/product/principles",
    "docs/operations",
    ".agents/skills/future-planner"
  ],
  "required_reads": [
    "docs/product/principles/README.md",
    "docs/roadmap/README.md",
    "docs/development/documentation.md",
    "consent-protocol/docs/reference/personal-knowledge-model.md"
  ],
  "required_commands": [
    "./bin/hushh agents route-task future-roadmap-plan"
  ],
  "verification_bundle": {
    "id": "future-roadmap-plan",
    "commands": [
      "python3 .agents/skills/codex-skill-authoring/scripts/skill_lint.py",
      "./bin/hushh docs verify",
      "./bin/hushh agents audit"
    ],
    "tests": [
      "python3 .agents/skills/codex-skill-authoring/scripts/skill_lint.py",
      "./bin/hushh agents audit"
    ]
  },
  "deliverables": [
    "planning-only future-state doc",
    "north-star vs future vs execution classification",
    "promotion criteria and risk summary"
  ],
  "impact_fields": [
    "Docs updated",
    "Verification commands executed"
  ],
  "handoff_chain": [
    "future-planner",
    "docs-governance",
    "planning-board",
    "repo-context"
  ],
  "common_failures": [
    "mixing future-roadmap concepts into vision docs",
    "writing speculative implementation detail as if it is already approved",
    "ignoring trust, PKM, or consent edge cases"
  ]
}
