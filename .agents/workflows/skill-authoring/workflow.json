{
  "id": "skill-authoring",
  "title": "Skill Authoring",
  "goal": "Create or retrofit skills, manifests, workflows, and routing metadata for the portable agent operating system.",
  "owner_skill": "skill-authoring",
  "default_spoke": null,
  "task_type": "skill-authoring",
  "affected_surfaces": [
    ".agents/skills",
    ".agents/workflows",
    "docs/operations",
    "README.md"
  ],
  "required_reads": [
    ".agents/skills/skill-authoring/references/skill-contract.md",
    ".agents/skills/skill-authoring/references/authoring-workflow.md",
    ".agents/skills/repo-context/references/index-contract.md"
  ],
  "required_commands": [
    "./bin/hushh agents route-task skill-authoring",
    "python3 .agents/skills/skill-authoring/scripts/skill_lint.py",
    "python3 .agents/skills/skill-authoring/scripts/trigger_evals.py --text"
  ],
  "verification_bundle": {
    "id": "skill-authoring",
    "commands": [
      "python3 .agents/skills/skill-authoring/scripts/skill_lint.py",
      "python3 .agents/skills/skill-authoring/scripts/trigger_evals.py --text",
      "./bin/hushh agents audit",
      "./bin/hushh docs verify"
    ],
    "tests": [
      "python3 .agents/skills/skill-authoring/scripts/skill_lint.py",
      "python3 .agents/skills/skill-authoring/scripts/trigger_evals.py --text",
      "./bin/hushh agents audit"
    ]
  },
  "deliverables": [
    "skill and workflow manifests",
    "updated taxonomy or routing docs",
    "validation summary"
  ],
  "impact_fields": [
    "Docs updated",
    "Verification commands executed"
  ],
  "handoff_chain": [
    "skill-authoring",
    "repo-context",
    "docs-governance"
  ],
  "common_failures": [
    "adding markdown-only skills without manifest metadata",
    "creating overlapping task types",
    "forgetting onboarding or audit updates"
  ]
}
