{
  "id": "release-readiness",
  "title": "Release Readiness",
  "goal": "Assess exact-candidate core and affected-contract evidence before an explicitly authorized release. Full historical suites and advisory hygiene are optional diagnostics, not routine prerequisites.",
  "owner_skill": "repo-operations",
  "default_spoke": null,
  "task_type": "release-readiness",
  "affected_surfaces": [
    "bin",
    "scripts",
    "deploy",
    "docs/reference/operations",
    "hushh-webapp/scripts",
    "consent-protocol/scripts"
  ],
  "required_reads": [
    "docs/reference/operations/ci.md",
    "docs/reference/operations/branch-governance.md",
    ".agents/skills/repo-operations/references/admin-release-sop.md",
    "docs/reference/quality/pr-impact-checklist.md",
    "docs/reference/kai/kai-runtime-smoke-checklist.md"
  ],
  "required_commands": [
    "./bin/hushh agents route-task release-readiness",
    "./bin/hushh agents ci-status"
  ],
  "verification_bundle": {
    "id": "release-readiness",
    "commands": [
      "./bin/hushh agents ci-status"
    ],
    "tests": []
  },
  "deliverables": [
    "release checklist summary",
    "verification report",
    "remaining launch-risk debt",
    "exact-source core and affected-contract proof, with missing evidence explicit"
  ],
  "impact_fields": [
    "Preserved developer branch",
    "Branch restoration or back-sync state",
    "Docs updated",
    "Verification commands executed",
    "Mobile parity impacts"
  ],
  "handoff_chain": [
    "repo-operations",
    "quality-contracts",
    "mobile-parity-audit",
    "docs-governance",
    "security-audit"
  ],
  "common_failures": [
    "treating advisory findings as invisible",
    "shipping without docs parity",
    "skipping native checks when mobile surfaces changed",
    "dispatching or fixing from a temporary branch without restoring the preserved developer branch",
    "letting main hotfixes drift away from the active development branch"
  ]
}
