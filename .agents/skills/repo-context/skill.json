{
  "id": "repo-context",
  "role": "owner",
  "owner_family": "repo-context",
  "primary_scope": "repo-context-intake",
  "description": "Use when a request starts with scanning the Hussh repository, establishing repo context, mapping code/docs/skills, or deciding which owner skill should own the next step.",
  "owned_paths": [
    "README.md",
    "data"
  ],
  "non_owned_paths": [
    "frontend",
    "mobile-native",
    "backend",
    "security-audit",
    "docs-governance",
    "repo-operations",
    "analytics-observability-governance",
    "oss-license-governance",
    "contributor-onboarding",
    "subtree-upstream-governance"
  ],
  "task_types": [
    "repo-orientation",
    "bug-triage",
    "skill-authoring",
    "data-model-audit"
  ],
  "required_reads": [
    ".agents/skills/repo-context/references/index-contract.md",
    ".agents/skills/repo-context/references/ownership-map.md",
    "docs/development/repository-map.md"
  ],
  "required_commands": [
    "./bin/hushh agents scan summary",
    "./bin/hushh agents list-workflows",
    "./bin/hushh agents route-task repo-orientation",
    "./bin/hushh agents impact repo-orientation",
    "./bin/hushh agents data-model-audit",
    "./bin/hushh agents audit",
    "python3 .agents/skills/repo-context/scripts/repo_scan.py validate",
    "python3 .agents/skills/repo-context/scripts/architecture_fitness.py --self-test && python3 .agents/skills/repo-context/scripts/architecture_fitness.py --limit 20"
  ],
  "verification_bundles": [
    {
      "id": "repo-context-core",
      "commands": [
        "./bin/hushh agents scan summary",
        "./bin/hushh agents list-workflows",
        "./bin/hushh agents route-task repo-orientation",
        "./bin/hushh agents impact repo-orientation",
        "./bin/hushh agents data-model-audit",
        "./bin/hushh agents audit",
        "python3 .agents/skills/repo-context/scripts/repo_scan.py validate",
        "python3 .agents/skills/repo-context/scripts/architecture_fitness.py --self-test && python3 .agents/skills/repo-context/scripts/architecture_fitness.py --limit 20"
      ],
      "tests": [
        "./bin/hushh agents audit",
        "./bin/hushh agents data-model-audit",
        "python3 .agents/skills/repo-context/scripts/repo_scan.py validate",
        "python3 .agents/skills/repo-context/scripts/architecture_fitness.py --self-test && python3 .agents/skills/repo-context/scripts/architecture_fitness.py --limit 20"
      ]
    }
  ],
  "handoff_targets": [
    "frontend",
    "mobile-native",
    "backend",
    "security-audit",
    "docs-governance",
    "analytics-observability-governance",
